digraph G { rankdir=TB; nodesep=0.4; ranksep=0.7; graph [fontname="DejaVu Sans" pad=0.4 labelloc=t fontsize=20 bgcolor=white]
node [shape=box style="rounded,filled" fontname="DejaVu Sans" fontsize=13 margin="0.25,0.15" color="#333333" penwidth=1.2]
edge [fontname="DejaVu Sans" fontsize=12 color="#444444"]
label="Nivel 3 - Componentes: API + Pipeline de 7 etapas";
node [fillcolor="#85bbf0"];
main [label="main.py\nRouters + CORS"];
auth [label="core.current_user\nJWT + rate limit\n(ventana 60s)"];
chat [label="llm.chat\nOllama + breaker"];
st1 [fillcolor="#00bcd4" label="01 Ingest\nHTTP Webhook"];
st2 [fillcolor="#00bcd4" label="02 Validar\nSchema JSON"];
st3 [fillcolor="#4caf50" label="03 Limpiar\nHTML -> texto plano"];
st4 [fillcolor="#f5a623" label="04 Analizar\nLLM: categoria"];
st5 [fillcolor="#b39ddb" label="05 Enriquecer\nLLM: NER + sentimiento"];
st6 [fillcolor="#ff8a9b" label="06 Resumen SEO\nLLM: < 160 chars"];
st7 [fillcolor="#4caf50" label="07 Exportar\nDB + Webhook"];
span [fillcolor="#f5e6a8" label="core.span\nlatencia, tokens, costo"];
store [fillcolor="#438dd5" fontcolor=white label="store.py\nSQLite"];
main -> auth; main -> st1; main -> chat [label="/chat"];
st1 -> st2 -> st3 -> st4 -> st5 -> st6 -> st7;
st4 -> chat [style=dashed]; st5 -> chat [style=dashed]; st6 -> chat [style=dashed];
st1 -> store [style=dashed label="queued"]; st7 -> store [style=dashed label="done"];
span -> st4 [style=dotted arrowhead=none label="envuelve cada etapa"];
}
