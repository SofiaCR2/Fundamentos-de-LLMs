digraph G { rankdir=TB; nodesep=0.9; ranksep=1.0; graph [fontname="DejaVu Sans" pad=0.4 labelloc=t fontsize=20 bgcolor=white]
node [shape=box style="rounded,filled" fontname="DejaVu Sans" fontsize=13 margin="0.25,0.15" color="#333333" penwidth=1.2]
edge [fontname="DejaVu Sans" fontsize=12 color="#444444"]
label="Nivel 1 - Contexto del sistema";
editor [fillcolor="#08427b" fontcolor=white label="Editor / Analista\n[Persona]\nEnvia articulos, revisa analisis\ny usa el chat editorial"];
cms [fillcolor="#999999" fontcolor=white label="CMS MediaGroup LATAM\n[Sistema externo]\nPublica articulos"];
sys [fillcolor="#1168bd" fontcolor=white fontsize=14 label="Pipeline de Analisis Inteligente\n[Sistema]\nIngiere, analiza (LLM), enriquece (NER +\nsentimiento), resume (SEO) y exporta"];
ollama [fillcolor="#999999" fontcolor=white label="Ollama Runtime\n[Sistema local :11434]\nllama3.2:3b (GGUF)"];
dest [fillcolor="#999999" fontcolor=white label="Sistema receptor\n[Webhook consumidor]\nRecibe el resultado enriquecido"];
editor -> sys [label="Usa (HTTPS, JWT)"];
cms -> sys [label="POST /webhook/articles\n(JSON, 202 < 200ms)"];
sys -> ollama [label="Inferencia\n(HTTP /api/chat)"];
sys -> dest [label="Callback webhook\n(JSON resultado)"];
}
