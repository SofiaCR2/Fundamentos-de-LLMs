digraph G { rankdir=TB; nodesep=0.6; ranksep=1.0; compound=true; graph [fontname="DejaVu Sans" pad=0.4 labelloc=t fontsize=20 bgcolor=white]
node [shape=box style="rounded,filled" fontname="DejaVu Sans" fontsize=13 margin="0.25,0.15" color="#333333" penwidth=1.2]
edge [fontname="DejaVu Sans" fontsize=12 color="#444444"]
label="Nivel 2 - Contenedores y flujos de datos (numerados)";
editor [fillcolor="#08427b" fontcolor=white label="Editor / Analista\n[Persona]"];
cms [fillcolor="#999999" fontcolor=white label="CMS MediaGroup\n[Externo]"];
dest [fillcolor="#999999" fontcolor=white label="Sistema receptor\n[Externo]"];
spa [fillcolor="#438dd5" fontcolor=white label="SPA Frontend\n[React 18 + Vite :5173]\nLogin, articulos, chat, dashboard"];
subgraph cluster_api { label="Proceso FastAPI / uvicorn :8000"; style="rounded,dashed"; fontsize=12; color="#1168bd";
  api [fillcolor="#438dd5" fontcolor=white label="API REST\n[FastAPI]\nJWT, rate limit, validacion\n(pydantic), endpoints"];
  pipe [fillcolor="#438dd5" fontcolor=white label="Pipeline asincrono\n[BackgroundTasks]\n7 etapas, spans por etapa"];
  cb [fillcolor="#85bbf0" label="Cliente LLM\n[httpx + Circuit Breaker]\ntimeout 120s, 1 reintento"];
}
db [shape=cylinder style=filled fillcolor="#438dd5" fontcolor=white label="Base de datos\n[SQLite]\narticulos, resultados,\nmetricas"];
ollama [fillcolor="#2e8b57" fontcolor=white label="Ollama server\n[systemd :11434]\nllama3.2:3b"];
logs [shape=note fillcolor="#f5e6a8" label="Logs JSON estructurados\n[stdout -> journald]"];
editor -> spa [label="1 usa"];
spa -> api [label="2 POST /auth/token\n3 GET /articles, /dashboard\n4 POST /chat"];
cms -> api [label="5 POST /webhook/articles"];
api -> pipe [label="6 encola (202)"];
pipe -> cb [label="7 prompts"];
cb -> ollama [label="8 /api/chat"];
pipe -> db [label="9 guarda estado + resultado"];
api -> db [label="lecturas"];
pipe -> dest [label="10 callback"];
api -> logs [style=dashed label="eventos"];
pipe -> logs [style=dashed];
}
